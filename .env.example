# Local eval database, started by `docker compose up -d`.
# Port 57557 avoids colliding with any other Postgres on the machine.
DATABASE_URL=postgres://postgres:postgres@localhost:57557/syntec

# Generation and the LLM judge. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Requests must name a workspace: this key is organization-scoped.
ANTHROPIC_WORKSPACE_ID=

# Embeddings and reranking. https://dash.voyageai.com
VOYAGE_API_KEY=

# Hard ceiling on provider spend, enforced in code. A billed call is refused once
# the recorded total reaches this. Check with `pnpm spend`.
BUDGET_EUR=20

# Public demo database. Separate from the local eval database on purpose: the demo is
# read-only over the corpus and must never be pointed at a database the harness drops.
DEMO_DATABASE_URL=

# Public demo limits.
DEMO_DAILY_CAP_EUR=0.5
DEMO_PER_IP_PER_HOUR=12
IP_SALT=
