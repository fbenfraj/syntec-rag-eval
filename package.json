{
  "name": "syntec-rag-eval",
  "version": "1.0.0",
  "description": "Measured retrieval over the Code du travail and the Syntec convention collective",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "corpus:fetch": "./scripts/fetch-corpus.sh",
    "corpus:build": "tsx scripts/build-corpus.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "corpus:load": "tsx scripts/load-corpus.ts",
    "smoke": "tsx scripts/smoke-providers.ts",
    "embed": "tsx scripts/embed-corpus.ts",
    "spend": "tsx scripts/spend.ts",
    "baseline:build": "tsx scripts/build-baseline.ts",
    "baseline:embed": "tsx scripts/embed-corpus.ts --fixed",
    "gold:generate": "tsx scripts/generate-gold.ts",
    "gold:validate": "tsx scripts/validate-gold.ts",
    "gold:review": "tsx scripts/review-gold.ts",
    "gold:apply-review": "tsx scripts/apply-review.ts",
    "gold:review-pack": "tsx scripts/llm-review-pack.ts",
    "gold:apply-llm-review": "tsx scripts/apply-llm-review.ts",
    "judge:calibrate": "tsx scripts/calibrate-judge.ts",
    "eval": "tsx scripts/run-eval.ts",
    "leaderboard": "tsx scripts/leaderboard.ts",
    "rescore": "tsx scripts/rescore.ts",
    "failures": "tsx scripts/failures.ts",
    "site:data": "tsx scripts/site-data.ts",
    "judge:apply-calibration": "tsx scripts/apply-calibration.ts",
    "judge:prescreen": "tsx scripts/prescreen-calibration.ts",
    "rejudge": "tsx scripts/rejudge.ts",
    "merge-rubrics": "tsx scripts/merge-rubrics.ts",
    "demo:seed": "tsx scripts/seed-demo.ts"
  },
  "author": "Farouk Ben Fraj",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
